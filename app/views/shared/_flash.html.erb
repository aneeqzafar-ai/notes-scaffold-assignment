<% flash.each do |type, message| %>

  <% next if message.blank? %>

  <div class="mx-auto mt-4 w-full max-w-7xl px-6 lg:px-10">

    <div
      class="
        flex items-center justify-between rounded-xl border px-4 py-3 text-sm shadow-sm
        <%= type.to_s == "alert" ?
                           "border-red-200 bg-red-50 text-red-700" :
                           "border-green-200 bg-green-50 text-green-700" %>
      "
    >

      <div class="flex items-center gap-2">

        <span>
          <%= type.to_s == "alert" ? "!" : "✓" %>
        </span>

        <span class="font-medium">
          <%= message %>
        </span>

      </div>

    </div>

  </div>

<% end %>