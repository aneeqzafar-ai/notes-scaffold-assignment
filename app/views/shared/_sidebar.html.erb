<aside class="sticky top-16 hidden h-[calc(100vh-4rem)] w-64 shrink-0 border-r border-gray-200 bg-white md:block">

  <div class="flex h-full flex-col p-4">

    <nav class="space-y-1">

      <%= link_to notes_path,
                  class: "flex items-center gap-3 rounded-xl bg-gray-100 px-3 py-2.5 text-sm font-medium text-gray-900" do %>

        <span>📝</span>
        <span>All Notes</span>

      <% end %>


      <a
        href="#"
        class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-gray-500 transition hover:bg-gray-100 hover:text-gray-900"
      >
        <span>☆</span>
        <span>Favorites</span>
      </a>


      <a
        href="#"
        class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-gray-500 transition hover:bg-gray-100 hover:text-gray-900"
      >
        <span>🗑</span>
        <span>Trash</span>
      </a>

    </nav>


    <div class="mt-auto pt-6">

      <%= link_to new_note_path,
                  class: "flex w-full items-center justify-center gap-2 rounded-xl bg-gray-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-gray-700" do %>

        <span>+</span>
        <span>New Note</span>

      <% end %>

    </div>

  </div>

</aside>