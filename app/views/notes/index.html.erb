<% content_for :title, "Notes" %>

<div class="mx-auto w-full max-w-7xl px-6 py-10 lg:px-10">

  <!-- Page header -->
  <div class="flex items-start justify-between gap-6">

    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
        Notes
      </h1>

      <p class="mt-2 text-sm text-gray-500">
        Capture your thoughts, ideas, and anything worth remembering.
      </p>
    </div>

    <%= link_to new_note_path,
                class: "shrink-0 inline-flex items-center justify-center gap-2 rounded-xl bg-gray-900 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-gray-700" do %>
      <span>+</span>
      <span>New Note</span>
    <% end %>

  </div>


  <!-- Search -->
  <div class="mt-8">
    <div class="relative">

      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
        <svg
            class="h-5 w-5 text-gray-400"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            aria-hidden="true"
        >
          <path
              d="m14.5 14.5 4 4m-2-9a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
              stroke-width="1.5"
              stroke-linecap="round"
              />
        </svg>
      </div>

      <input
          type="text"
          placeholder="Search your notes..."
          class="w-full rounded-xl border border-gray-200 bg-white py-3 pl-11 pr-4 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-gray-400 focus:ring-2 focus:ring-gray-100"
      >

    </div>
  </div>


  <!-- Notes section -->
  <section class="mt-10">

    <div class="mb-5 flex items-center justify-between">

      <h2 class="text-lg font-semibold text-gray-900">
        All Notes
      </h2>

      <span class="text-sm text-gray-500">
        <%= pluralize(@notes.count, "note") %>
      </span>

    </div>


    <% if @notes.any? %>

      <div id="notes" class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
        <%= render @notes %>
      </div>

    <% else %>

      <div class="rounded-2xl border border-dashed border-gray-300 bg-white px-6 py-16 text-center">

        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-gray-100 text-xl">
          📝
        </div>

        <h3 class="mt-4 text-base font-semibold text-gray-900">
          No notes yet
        </h3>

        <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-gray-500">
          Create your first note to start capturing ideas, thoughts, and anything worth remembering.
        </p>

        <%= link_to new_note_path,
                    class: "mt-6 inline-flex items-center gap-2 rounded-xl bg-gray-900 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-gray-700" do %>

          <span>+</span>
          <span>Create your first note</span>

        <% end %>

      </div>

    <% end %>

  </section>

</div>