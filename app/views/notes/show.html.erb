<% content_for :title, @note.title %>

<div class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6 sm:py-8 lg:px-10 lg:py-10">

  <!-- Top navigation -->
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <%= link_to notes_path,
                class: "inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition hover:text-gray-900" do %>

      <span>←</span>
      <span>Back to notes</span>

    <% end %>


    <div class="flex items-center gap-2">

      <%= link_to edit_note_path(@note),
                  class: "rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm transition hover:bg-gray-50" do %>

        <span>Edit</span>

      <% end %>


      <%= button_to note_path(@note),
                    method: :delete,
                    class: "rounded-xl border border-red-200 bg-white px-4 py-2 text-sm font-medium text-red-600 shadow-sm transition hover:bg-red-50",
                    form: {
                      data: {
                        turbo_confirm: "Are you sure you want to delete this note?"
                      }
                    } do %>

        Delete

      <% end %>

    </div>

  </div>


  <!-- Note -->
  <article class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-10">

    <div class="mb-8 flex flex-col gap-4 border-b border-gray-100 pb-6 sm:flex-row sm:items-center sm:justify-between">

      <div class="flex items-center gap-3">

        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gray-100 text-lg">
          📝
        </div>

        <div>
          <p class="text-sm font-medium text-gray-700">
            Note
          </p>

          <p class="text-xs text-gray-400">
            Created <%= time_ago_in_words(@note.created_at) %> ago
          </p>
        </div>

      </div>


      <p class="text-xs text-gray-400">
        Updated <%= time_ago_in_words(@note.updated_at) %> ago
      </p>

    </div>


    <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
      <%= @note.title %>
    </h1>


    <div class="mt-6 whitespace-pre-wrap text-base leading-8 text-gray-600">
      <%= @note.body %>
    </div>

  </article>

</div>