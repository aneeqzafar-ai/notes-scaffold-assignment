<%= form_with(model: note, class: "space-y-6") do |form| %>

  <% if note.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4">

      <h2 class="text-sm font-semibold text-red-800">
        <%= pluralize(note.errors.count, "error") %>
        prevented this note from being saved.
      </h2>

      <ul class="mt-2 list-inside list-disc space-y-1 text-sm text-red-700">
        <% note.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>

    </div>
  <% end %>


  <!-- Title -->
  <div>
    <%= form.label :title,
                   class: "mb-2 block text-sm font-medium text-gray-700" %>

    <%= form.text_field :title,
                        placeholder: "Give your note a title...",
                        class: "block w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-gray-400 focus:ring-2 focus:ring-gray-100" %>
  </div>


  <!-- Body -->
  <div>
    <div class="mb-2 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">

      <%= form.label :body,
                     class: "block text-sm font-medium text-gray-700" %>

      <span class="text-xs text-gray-400">
        Write anything worth remembering
      </span>

    </div>

    <%= form.textarea :body,
                      rows: 10,
                      placeholder: "Start writing...",
                      class: "block w-full resize-none rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm leading-6 text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-gray-400 focus:ring-2 focus:ring-gray-100" %>
  </div>


  <!-- Actions -->
  <div class="flex flex-col-reverse gap-3 border-t border-gray-100 pt-6 sm:flex-row sm:items-center sm:justify-end">

    <%= link_to "Cancel",
                notes_path,
                class: "rounded-xl px-4 py-2.5 text-center w-full sm:w-auto text-sm font-medium text-gray-600 transition hover:bg-gray-100 hover:text-gray-900" %>

    <%= form.submit(
          note.persisted? ? "Save Changes" : "Create Note",
          class: "cursor-pointer rounded-xl bg-gray-900 px-5 py-2.5 text-sm w-full sm:w-auto font-medium text-white shadow-sm transition hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2"
        ) %>

  </div>

<% end %>