<% content_for :title, "New Note" %>

<div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6 sm:py-8 lg:px-10 lg:py-10">

  <div class="mb-8">

    <%= link_to notes_path,
                class: "mb-6 inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition hover:text-gray-900" do %>

      <span>←</span>
      <span>Back to notes</span>

    <% end %>


    <h1 class="text-3xl font-bold tracking-tight text-gray-900">
      Create a note
    </h1>

    <p class="mt-2 text-sm text-gray-500">
      Capture an idea, thought, or anything you want to remember.
    </p>

  </div>


  <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
    <%= render "form", note: @note %>
  </div>

</div>